{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run alembic *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(docker compose down -v)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes)",
      "Bash(docker compose down --volumes *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-openapi-sync.sh",
            "if": "Bash(git commit *)",
            "timeout": 15,
            "statusMessage": "Verificando que openapi.json coincida con el código..."
          }
        ]
      }
    ]
  }
}
